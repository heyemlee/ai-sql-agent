# AI SQL Agent — local configuration template
#
# Usage: cp .env.example .env, then fill in real values.
# .env is gitignored and never gets committed.
#
# The main path (retrieval -> planning -> generation) only needs a Chat
# endpoint: keyword extraction falls back to local rules and vectors to a
# local hash, so section 2 alone is enough to run the benchmark.

# ============================================================
# 1. Provider — switching this one line switches the whole stack
#    openai    = OpenAI-compatible protocol (/chat/completions + Authorization: Bearer)
#    anthropic = Anthropic Messages protocol (/v1/messages + x-api-key)
# ============================================================
AI_SQL_MODEL_PROVIDER=openai

# ============================================================
# 2. Credentials — only the provider selected above is used.
#    BASE_URL takes the official endpoint or your own relay.
# ============================================================

# ---- OpenAI-compatible channel (OpenAI, relays, vLLM and Ollama all speak this) ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Anthropic channel ----
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Heads-up: environment variables outrank .env. A terminal with Claude Code
# installed exports ANTHROPIC_BASE_URL, which silently overrides the line above
# and shows up as a 401 when you meant to reach a relay. Use the AI_SQL_ prefix
# instead — highest priority, and it cannot collide with another tool:
# AI_SQL_ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_SQL_ANTHROPIC_BASE_URL=https://your-relay.example.com

# ============================================================
# 3. Models — leave unset to take the provider default
#    openai    -> gpt-5.6-luna      ($0.20 / $1.20 per 1M tokens, Sept 2026)
#    anthropic -> claude-sonnet-5
#    AI_SQL_CHAT_MODEL  = planning / routing / keyword extraction
#    AI_SQL_CODER_MODEL = SQL generation, worth a stronger model on wide schemas
# ============================================================
# AI_SQL_CHAT_MODEL=gpt-5.6-luna
# AI_SQL_CODER_MODEL=gpt-5.6-terra
# AI_SQL_CHAT_MODEL=claude-sonnet-5
# AI_SQL_CODER_MODEL=claude-opus-5

# The Anthropic Messages protocol requires an explicit max_tokens. This is the default.
# AI_SQL_MAX_OUTPUT_TOKENS=4096

# ============================================================
# 4. Service auth — unrelated to the model keys above; this one guards
#    the API this project itself exposes.
#    Local dev defaults to disabled. Production sets api_key and mounts
#    deploy/api_keys.json (see deploy/README.md).
# ============================================================
# AI_SQL_AUTH_MODE=api_key
# AI_SQL_API_KEYS_FILE=deploy/api_keys.json
