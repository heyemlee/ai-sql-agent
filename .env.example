# AI SQL Agent 本地配置模板
#
# 用法：cp .env.example .env  然后填入真实值
# .env 已在 .gitignore 中，不会被提交。
#
# 主链路（检索→规划→生成）只需要 Chat 一种接口——关键词抽取走本地规则、
# 向量走本地哈希、Rerank 未配置时走本地词面打分，所以跑 benchmark 只填 Chat 即可。

# ============================================================
# 1. 选厂商：改这一行就整体切换，代码不用动
#    openai    = OpenAI 兼容协议（/chat/completions + Authorization: Bearer）
#    anthropic = Anthropic Messages 协议（/v1/messages + x-api-key）
# ============================================================
AI_SQL_MODEL_PROVIDER=openai

# ============================================================
# 2. 填凭证：两套都填也没关系，上面选中哪个就用哪个
# ============================================================

# ---- OpenAI 兼容通道（OpenAI 官方 / 中转站 / 百炼 / vLLM / Ollama 都是这套）----
OPENAI_API_KEY=sk-在这里填你的key
OPENAI_BASE_URL=https://api.kabi.pro/v1

# ---- Anthropic 通道 ----
ANTHROPIC_API_KEY=sk-ant-在这里填你的key
ANTHROPIC_BASE_URL=https://api.kabi.pro
# 注意：环境变量优先级高于 .env。装了 Claude Code 的终端会导出
# ANTHROPIC_BASE_URL=https://api.anthropic.com，会把上面这行盖掉（表现为 401）。
# 遇到这种情况改用 AI_SQL_ 前缀，它的优先级最高、也不会跟别的工具撞名：
# AI_SQL_ANTHROPIC_API_KEY=sk-ant-在这里填你的key
# AI_SQL_ANTHROPIC_BASE_URL=https://api.kabi.pro

# ============================================================
# 3. 选模型：留空则按厂商取默认值
#    openai    默认 gpt-4o-mini
#    anthropic 默认 claude-sonnet-5
#    AI_SQL_CHAT_MODEL  = 规划/路由/关键词抽取
#    AI_SQL_CODER_MODEL = SQL 生成（可以单独用更强的模型）
# ============================================================
# AI_SQL_CHAT_MODEL=gpt-4o-mini
# AI_SQL_CODER_MODEL=gpt-4o-mini
# AI_SQL_CHAT_MODEL=claude-sonnet-5
# AI_SQL_CODER_MODEL=claude-opus-5

# Anthropic Messages 协议要求显式给 max_tokens，这里是默认值
# AI_SQL_MAX_OUTPUT_TOKENS=4096

# ============================================================
# 内网自建 vLLM（数据不出内网，详见 deploy/README.md）
# 路径非标准时直接写完整端点，优先级高于上面的 BASE_URL 拼接
# ============================================================
# AI_SQL_MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-internal-vllm
# AI_SQL_CHAT_URL=http://vllm-chat:8000/v1/chat/completions
# AI_SQL_EMBEDDING_URL=http://vllm-embed:8000/v1/embeddings
# AI_SQL_CHAT_MODEL=Qwen2.5-14B-Instruct
# AI_SQL_CODER_MODEL=Qwen2.5-Coder-14B-Instruct
# AI_SQL_EMBEDDING_MODEL=bge-m3

# ============================================================
# Embedding 凭证（可选）
# Anthropic 不提供 Embedding 接口，Embedding 始终走 OpenAI 兼容协议。
# 只有走 pgvector 向量索引时才需要；留空则回落到 OPENAI_API_KEY。
# ============================================================
# AI_SQL_EMBEDDING_API_KEY=sk-另一家的key
# AI_SQL_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings

# ============================================================
# Rerank（可选，阿里云百炼 qwen3-rerank）
# 配了 workspace_id 才会启用真实 Rerank，否则字段级精排走本地词面打分。
# 凭证留空则回落到 OPENAI_API_KEY。
# ============================================================
# DASHSCOPE_WORKSPACE_ID=llm-xxxxxxxx
# AI_SQL_RERANK_API_KEY=sk-百炼key

# ============================================================
# 存储（可选，不填用本地 SQLite + 内存向量索引）
# ============================================================
# AI_SQL_PGVECTOR_DSN=postgresql://ai_sql:ai_sql@localhost:5432/ai_sql

# ============================================================
# 服务自身鉴权（注意：这跟上面的模型 key 是两回事）
# 本地开发默认 disabled；生产设为 api_key 并挂载 deploy/api_keys.json
# ============================================================
# AI_SQL_AUTH_MODE=api_key
# AI_SQL_API_KEYS_FILE=deploy/api_keys.json
